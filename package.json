{
  "name": "dsh-plugin-danmu",
  "version": "0.3.0",
  "description": "Live danmu overlays for DeepSeek Harness (dsh) that visualize agent activity and status, such as reasoning, tool calls, and task progress.",
  "keywords": [
    "bilibili",
    "cordis",
    "danmaku",
    "danmu",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin"
  ],
  "homepage": "https://github.com/xueelf/dsh-plugin-danmu#readme",
  "bugs": {
    "url": "https://github.com/xueelf/dsh-plugin-danmu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueelf/dsh-plugin-danmu.git"
  },
  "license": "MIT",
  "author": "Yuki <admin@yuki.sh>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "licenses/*"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "format": "prettier \"**/*.{css,json,md,ts,tsx,yaml,yml}\" --write --experimental-cli",
    "format:check": "prettier \"**/*.{css,json,md,ts,tsx,yaml,yml}\" --check --experimental-cli",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "prepack": "bun run build",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^18.2.0",
    "annal": "^0.2.1",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "prettier-plugin-sort": "^1.1.2",
    "remove-markdown": "^0.8.0",
    "typescript-eslint": "^8.70.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "warn"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
